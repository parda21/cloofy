{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloofy-website",
	// The account cloofy.app is in; a Worker's custom domain must be in the zone's account.
	"account_id": "3d72589aaa1696b876797d92926662f9",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// Everything else is static, served without running the Worker.
		"run_worker_first": ["/install.sh", "/install"]
	},
	// cloofy.app and www, with their DNS records and certificates made by Cloudflare. A redirect
	// rule on the zone sends www to cloofy.app.
	"routes": [
		{ "pattern": "cloofy.app", "custom_domain": true },
		{ "pattern": "www.cloofy.app", "custom_domain": true }
	],
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true }
}
