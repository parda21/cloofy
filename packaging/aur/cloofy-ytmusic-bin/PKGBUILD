# Made for each release from packaging/aur/cloofy-ytmusic-bin/PKGBUILD in https://github.com/parda21/cloofy.
# Maintainer: parda21 <36790116+parda21@users.noreply.github.com>

# The YouTube Music build, without Spotify. mpv plays, yt-dlp finds the streams, and deno
# solves YouTube's challenges for yt-dlp.
pkgname=cloofy-ytmusic-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='YouTube Music client for the terminal'
arch=('x86_64' 'aarch64')
url='https://github.com/parda21/cloofy'
license=('MIT')
depends=('deno' 'glibc' 'libgcc' 'mpv' 'yt-dlp')
provides=("cloofy=$pkgver")
conflicts=('cloofy')
# The release build comes stripped, so there is nothing for a debug package either.
options=('!strip' '!debug')
source_x86_64=("cloofy-ytmusic-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/cloofy-ytmusic-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("cloofy-ytmusic-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/cloofy-ytmusic-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('@SHA256_YTMUSIC_X86_64_UNKNOWN_LINUX_GNU@')
sha256sums_aarch64=('@SHA256_YTMUSIC_AARCH64_UNKNOWN_LINUX_GNU@')

package() {
  install -Dm755 cloofy "$pkgdir/usr/bin/cloofy"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
